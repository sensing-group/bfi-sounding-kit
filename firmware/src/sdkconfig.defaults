CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_ESP_TASK_WDT_EN=n
# Wi-Fi bring-up can transiently block interrupts longer than the default
# 300 ms on the C5, which panics and crash-loops the probe at boot.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
